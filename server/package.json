  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.11",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
