# Copy this file to .env and fill in your values
# .env is gitignored and should never be committed

# Database
# Local development: SQLite file path
DATABASE_URL=file:../mealio.db
# Production: PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/mealio

# Auth
# Any random string for local dev — rotate in production
JWT_SECRET=change_me_in_production

# App base URL (used for generating share links)
APP_URL=http://localhost:5173

# Anthropic Claude API
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TypeSafe AI / Jev (item category prediction) — https://docs.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Web Push (VAPID)
# Generate once with: npm run vapid:generate (from project root)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:you@example.com

# File Storage
# Local dev: relative path to uploads directory
UPLOAD_DIR=./uploads
# Production: set STORAGE_PROVIDER=s3 and configure S3 vars
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
